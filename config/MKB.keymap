// Wheel speed for &msc SCRL_UP / SCRL_DOWN. Must be defined before every include.

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include "MKB_jis.dtsi"

// Must stay after the JIS/key/board headers: it redefines RC for both matrix and modifier use.

#include "MKB_modifiers.h"

// Layer order follows LiNEA40. These stay plain single-level numeric defines in this file
// (not in an include) so Keymap Editor can resolve them.

#define DEF 0
#define IPAD 1
#define JIS 2
#define MOUSE 3
#define FUNC 4
#define NUM 5
#define JIS_FUNC 6
#define JIS_NUM 7
#define SCROLL 8
#define BT 9
#define EXCEL 10
#define JP_YEN          0x89
#define JP_TILDE    　　LS(JP_CARET)
#define JP_BACKQUOTE    LEFT_BRACE
#define JP_UNDERSCORE   LS(0x87)

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

// Mouse wheel timing used by the encoder (same values as LiNEA40).

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

// Layout-aware &kp (zmk-layout-shift v2 override), copied here so it comes after behaviors.dtsi
// and keeps working when Keymap Editor reorders the includes. The label property must stay
// identical to the kpls node: behavior lookup is by that shared label, so the single driver
// instance answers for both.

/ {
    behaviors {
        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
            display-name = "Key Press";
        };
    };
};

// The driver defines a single instance, so only &kp may stay enabled. mtls is a separate
// hold-tap; its keypress bindings are resolved through the shared label property, not through
// the same DT node. (The AML processor no longer looks at &kp: see the Mouse layer comment.)

&kpls { status = "disabled"; };

/ {
    behaviors {
        // Mouse wheel on the encoder: &encoder_msc_scroll <cw> <ccw>, e.g. SCRL_DOWN SCRL_UP.

        encoder_msc_scroll: encoder_msc_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        // Same timing as &lt. Holding enables Mouse (3) and protects it from the AML timeout.

        lt_mouse_keep: lt_mouse_keep {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            display-name = "Mouse Layer-Tap (AML guard)";
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mouse_hold_keep>, <&kp>;
        };

        // Only sets the keep flag of the AML processor; it does not activate any layer.
        // Needs the runtime input processor labelled aml3 (snippets/Default/Default.overlay).

        keep_aml_mouse: keep_aml_mouse {
            compatible = "zmk,behavior-input-processor-temp-layer-keep-active";
            #binding-cells = <0>;
            display-name = "Keep AML Mouse";
            processor-name = "aml3";
        };
    };

    macros {
        // Keep flag first (only sets the flag, does not activate a layer), then the layer.
        // Released in the opposite order; after the release the keep flag is cleared and normal AML resumes.

        mouse_hold_keep: mouse_hold_keep {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            display-name = "Mouse Hold (keep AML)";
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&keep_aml_mouse &macro_param_1to1 &mo MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mo MACRO_PLACEHOLDER &keep_aml_mouse>;
        };

        // Profile selectors for the BT layer: conversion state and base layer change together.
        // They do not touch Bluetooth pairing (use the BT_SEL keys for that).

        profile_current: profile_current {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Profile: Mac";
            bindings = <&tog_ls_off &to DEF>;
        };

        profile_ipad: profile_ipad {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Profile: iPad";
            bindings = <&tog_ls_off &to IPAD>;
        };

        profile_jis: profile_jis {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            display-name = "Profile: WinJIS";
            bindings = <&tog_ls_on &to JIS>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // ---- Layer 0: Mac (US layout OS). Fully explicit, no &trans: Keymap Editor shows every key. ----

        default_layer {
            label = "Mac";
            bindings = <
&kp ESCAPE    &kp Q         &kp W                    &kp E     &kp R           &kp T                      &kp Y          &kp U          &kp I         &kp O           &kp P      &kp DELETE
&kp TAB       &kp A         &kp S                    &kp D     &kp F           &kp G                      &kp H          &kp J          &lt SCROLL K  &kp L           &kp SEMI   &lt_mouse_keep MOUSE MINUS
&kp LSHFT     &kp Z         &kp X                    &kp C     &kp V           &kp B                      &kp N          &kp M          &kp COMMA     &kp DOT         &kp SLASH  &mt RIGHT_SHIFT SQT
&mt LCTL ESC  &kp LEFT_ALT  &mt LEFT_GUI LANGUAGE_2            &lt FUNC SPACE  &lt SCROLL LANGUAGE_1      &kp BACKSPACE  &lt NUM ENTER                &kp LG(LS(N5))  &kp RCTRL  &lt BT GRAVE
&kp LEFT      &kp UP        &kp SPACE                &kp DOWN  &kp RIGHT                                                 &kp HOME       &kp PG_UP     &kp ENTER       &kp PG_DN  &kp END
                                                     &kp A                                                                              &kp B
            >;

            sensor-bindings =
                <&encoder_msc_scroll SCRL_DOWN SCRL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 1: iPad. Mac copy with the LiNEA40 differences: Scroll on I (K is plain),
        // iPad screenshot at 43, encoder direction reversed. Fully explicit. ----

        ipad_layer {
            label = "iPad";
            bindings = <
&kp ESCAPE    &kp Q         &kp W                    &kp E     &kp R           &kp T                      &kp Y          &kp U          &lt SCROLL I  &kp O           &kp P      &kp DELETE
&kp TAB       &kp A         &kp S                    &kp D     &kp F           &kp G                      &kp H          &kp J          &kp K         &kp L           &kp SEMI   &lt_mouse_keep MOUSE MINUS
&kp LSHFT     &kp Z         &kp X                    &kp C     &kp V           &kp B                      &kp N          &kp M          &kp COMMA     &kp DOT         &kp SLASH  &mt RIGHT_SHIFT SQT
&mt LCTL ESC  &kp LEFT_ALT  &mt LEFT_GUI LANGUAGE_2            &lt FUNC SPACE  &lt SCROLL LANGUAGE_1      &kp BACKSPACE  &lt NUM ENTER                &kp LG(LS(N3))  &kp RCTRL  &lt BT GRAVE
&kp LEFT      &kp UP        &kp SPACE                &kp DOWN  &kp RIGHT                                                 &kp HOME       &kp PG_UP     &kp ENTER       &kp PG_DN  &kp END
                                                     &kp A                                                                              &kp B
            >;

            sensor-bindings =
                <&encoder_msc_scroll SCRL_UP SCRL_DOWN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 2: WinJIS (Windows, OS set to a JIS keyboard layout). Selected from the BT layer. ----
        // Mac copy with the Windows keys: Win/Esc at 36, MUHENKAN at 38, HENKAN (Scroll) at 40,
        // JFnc/JNum on the thumbs, Win+Shift+S screenshot. Fully explicit.
        // Minus (23) holds Excel (10). The manual Mouse layer moves to Delete (11), because the
        // 41-key LiNEA40 has no spare key for it on the MKB 58-key layout.

        jis_layer {
            label = "WinJIS";
            bindings = <
&kp ESCAPE        &kp Q         &kp W                 &kp E     &kp R               &kp T                      &kp Y          &kp U              &kp I         &kp O          &kp P          &lt_mouse_keep MOUSE DELETE
&kp TAB           &kp A         &kp S                 &kp D     &kp F               &kp G                      &kp H          &kp J              &lt SCROLL K  &kp L          &kp SEMI       &lt EXCEL MINUS
&kp LSHFT         &kp Z         &kp X                 &kp C     &kp V               &kp B                      &kp N          &kp M              &kp COMMA     &kp DOT        &kp SLASH      &mt RIGHT_SHIFT SQT
&mt LEFT_GUI ESC  &kp LEFT_ALT  &mt LCTRL LANGUAGE_2            &lt JIS_FUNC SPACE  &lt SCROLL LANGUAGE_1      &kp BACKSPACE  &lt JIS_NUM ENTER                &kp LS(LG(S))  &kp RIGHT_GUI  &lt BT GRAVE
&kp LEFT          &kp UP        &kp SPACE             &kp DOWN  &kp RIGHT                                                     &kp HOME           &kp PG_UP     &kp ENTER      &kp PG_DN      &kp END
                                                      &kp A                                                                                      &kp B
            >;

            sensor-bindings =
                <&encoder_msc_scroll SCRL_DOWN SCRL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 3: Mouse. Manual layer and the AML target (runtime processor "aml3"). ----
        // Clicks sit at 19 / 21 / 22. No sensor-bindings: the encoder follows the active base.
        //
        // AML keeps this layer on a key press only when the binding that key resolves to is a
        // non-transparent binding here, or an &mt whose hold modifier is in
        // temp-layer-keep-keycodes. The marker behavior is &mt (temp-layer-kp-behavior in
        // snippets/Default/Default.overlay); the runtime compares the behavior device and reads
        // param1, which for &mt is the hold modifier. Therefore:
        //  - 35 / 36 / 38 are &trans so the plain &mt of the active profile resolves
        //    (Mac: Ctrl/Cmd, WinJIS: Win/Ctrl). Do not replace those &mt with another hold-tap
        //    device; the marker would stop matching.
        //  - 24 (LSHFT), 37 (LALT) and 44 (RCTRL) are plain &kp in all three bases, so they are
        //    repeated here as &kp. Keep these three copies in sync with the base layers.

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans     &trans    &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans     &trans    &trans     &trans    &trans     &trans      &trans  &mkp MB1  &trans     &mkp MB2   &mkp MB3   &trans
&kp LSHFT  &trans    &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans     &kp LALT  &trans               &trans     &trans      &trans  &trans               &trans     &kp RCTRL  &trans
&kp LEFT   &kp UP    &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                &kp A                                              &kp B
            >;
        };

        // ---- Layer 4: Arrow (Mac function layer, held from the thumbs). ----

        function_layer {
            label = "Arrow";
            bindings = <
&trans    &kp F1   &kp F2              &kp F3         &kp F4             &kp F5         &kp F6     &kp F7          &kp F8          &kp F9                &kp F10           &trans
&trans    &kp F11  &kp LC(LEFT_ARROW)  &kp PAGE_UP    &kp LC(RIGHT)      &kp HOME       &kp LG(C)  &mkp MB1        &kp UP_ARROW    &mkp MB2              &mkp MB3          &trans
&trans    &kp F12  &kp LA(LG(LEFT))    &kp PAGE_DOWN  &kp LA(LG(RIGHT))  &kp END        &kp LG(V)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT             &kp RC(UP_ARROW)  &trans
&trans    &trans   &kp LALT                           &kp ENTER          &kp ENTER      &kp ENTER  &kp ENTER                       &kp RS(RG(NUMBER_4))  &kp RC(SPACE)     &trans
&kp LEFT  &kp UP   &kp SPACE           &kp DOWN       &kp RIGHT                                    &kp HOME        &kp PG_UP       &kp ENTER             &kp PG_DN         &kp END
                                       &kp A                                                                       &kp B
            >;

            sensor-bindings =
                <&encoder_msc_scroll SCRL_DOWN SCRL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 5: Num (Mac number / symbol layer). ----

        num_layer {
            label = "Num";
            bindings = <
&kp CAPS         &kp SLASH  &kp NUMBER_7  &kp N8        &kp N9        &kp LS(N8)         &kp BACKSLASH         &kp EXCLAMATION        &kp AT_SIGN       &kp HASH           &kp DOLLAR         &trans
&trans           &kp COLON  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS          &kp GRAVE             &kp PERCENT            &kp LCTRL         &kp AMPS           &kp SEMICOLON      &trans
&mt LSHFT SPACE  &kp UNDER  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(EQUAL)      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT            &trans
&trans           &kp ENTER  &kp N0                      &kp EQUAL     &kp ENTER          &kp ENTER             &kp ENTER                                &kp RS(GRAVE)      &kp DOUBLE_QUOTES  &trans
&kp LEFT         &kp UP     &kp SPACE     &kp DOWN      &kp RIGHT                                              &kp HOME               &kp PG_UP         &kp ENTER          &kp PG_DN          &kp END
                                          &kp A                                                                                       &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 6: ArrowWin (WinJIS function layer, held from the thumbs). ----
        // The 3x10 core follows the LiNEA40 ARROW_win_jp layer and sits on the inner ten columns of
        // rows 0-2 (positions 1-10, 13-22, 25-34). The outer positions 0 / 11 / 12 / 23 / 24 / 35
        // stay transparent. Bottom row (36-45) is LiNEA40 indices 30-40 without the unused 32.
        // The thumb keys 38-42 are transparent so the WinJIS thumb hold-taps keep working.

        jis_function_layer {
            label = "ArrowWin";
            bindings = <
&trans      &kp F1          &kp F2            &kp F3         &kp F4             &kp F5        &kp F6     &kp F7    &kp F8          &kp F9           &kp F10      &trans
&trans      &kp LC(HOME)    &kp LC(LG(LEFT))  &kp PAGE_UP    &kp LC(LG(RIGHT))  &kp HOME      &kp RC(C)  &mkp MB1  &kp UP_ARROW    &mkp MB2         &mkp MB3     &trans
&trans      &kp LC(END)     &kp LG(LEFT)      &kp PAGE_DOWN  &kp LG(RIGHT)      &kp END       &kp RC(V)  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT        &kp RG(TAB)  &trans
&kp ESCAPE  &kp INT_HENKAN  &trans                           &trans             &trans        &trans     &trans                    &kp PRINTSCREEN  &kp F11      &kp GRAVE
&kp LEFT    &kp UP          &kp SPACE         &kp DOWN       &kp RIGHT                                   &kp HOME  &kp PG_UP       &kp ENTER        &kp PG_DN    &kp END
                                              &kp A                                                                &kp B
            >;

            sensor-bindings =
                <&encoder_msc_scroll SCRL_RIGHT SCRL_LEFT>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 7: NumWin (WinJIS number / symbol layer). ----
        // US symbol names go through &kp once; the layout shift converts them for the JIS OS.
        // The core 3x10 follows LiNEA40 NUM_win_jp, whose raw JIS codes were translated to the US
        // symbol that produces the same character on a JIS OS (translated once, never twice):
        // raw LEFT_BRACKET = @, EQUAL = ^, CARET = &, RS(COLON) = +, PLUS = ~, AT_SIGN = ".
        // The digits are keypad digits, so Windows needs NumLock on: KP_NUMLOCK is at position 0.
        // Outer keys: 0 NumLock, 11 {, 12 Hankaku/Zenkaku, 23 }. Caret is in the core (position 20).
        // The "~" key moved from the old JNum position 43 to 44, the pipe to 43.

        jis_num_layer {
            label = "NumWin";
            bindings = <
&kp KP_NUMLOCK   &kp SLASH       &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp ASTERISK      &kp JP_YEN     &kp EXCLAMATION  &kp LEFT_BRACKET   &kp HASH   &kp DOLLAR     &trans
&kp LANGUAGE_5   &kp COLON       &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp MINUS         &kp LEFT_BRACE  &kp PERCENT      &kp EQUAL          &kp LCTRL  &kp SEMICOLON  &trans
&mt LSHFT SPACE  &kp JP_UNDERSCORE  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp RS(COLON)          &kp RS(N8)      &kp RS(N9)       &kp RIGHT_BRACKET  &kp BSLH   &kp AMPERSAND  &trans
&kp PERIOD       &kp PERIOD      &kp KP_NUMBER_0                   &kp EQUAL        &trans            &trans          &trans                              &kp PLUS   &kp AT_SIGN    &trans
&kp LEFT         &kp UP          &kp SPACE        &kp DOWN         &kp RIGHT                                          &kp HOME         &kp PG_UP          &kp ENTER  &kp PG_DN      &kp END
                                                  &kp A                                                                                &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 8: Scroll. The ball scrolls here (see the listener in Default.overlay). ----

        scroll_layer {
            label = "Scroll";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        // ---- Layer 9: BT. Bluetooth keys, studio unlock and the three profile selectors.
        // No sensor-bindings: the encoder follows the active base. ----
        // H (18) = Mac, J (19) = iPad, Minus (23) = WinJIS. The selectors do not change the BT pairing.

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR_ALL    &studio_unlock  &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &profile_current  &profile_ipad   &trans     &trans     &trans     &profile_jis
&trans      &trans        &trans        &trans        &trans        &trans            &trans            &trans          &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans            &trans            &trans                     &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                         &kp HOME        &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                                           &kp B
            >;
        };

        // ---- Layer 10: Excel. Held with Minus on WinJIS (23). H (18) sends the raw
        // Ctrl+Shift+; chord of LiNEA40 through the original (non layout-shifted) &kp, so it
        // bypasses the JIS conversion. Everything else falls through to the active base, and the
        // layer has no sensor-bindings. ----

        excel_layer {
            label = "Excel";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans      &trans                                 &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &original_key_press RC(RS(SEMICOLON))  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans                                 &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans      &trans                                 &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                                                     &trans  &trans  &trans  &trans  &trans
                        &trans                                                                     &trans
            >;
        };
    };
};
