// #include <layout_shift.dtsi>

#include <layout_shift_kp_override.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define FUNC 1
#define NUM 2
#define MOUSE 3
#define SCROLL 4
#define BT 5

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Def";
            bindings = <
&kp ESCAPE    &kp Q         &kp W                    &kp E     &kp R        &kp T                 &kp Y               &kp U          &kp I      &kp O           &kp P      &kp DELETE
&kp TAB       &kp A         &kp S                    &kp D     &kp F        &kp G                 &kp H               &kp J          &lt 4 K    &kp L           &kp SEMI   &lt MOUSE MINUS
&kp LSHFT     &kp Z         &kp X                    &kp C     &kp V        &kp B                 &kp N               &kp M          &kp COMMA  &kp DOT         &kp SLASH  &mt RIGHT_SHIFT SQT
&mt LCTL ESC  &kp LEFT_ALT  &mt LEFT_GUI LANGUAGE_2            &lt 1 SPACE  &lt 4 LANGUAGE_1      &lt FUNC BACKSPACE  &lt NUM ENTER             &kp LG(LS(N5))  &kp RCTRL  &lt 5 GRAVE
&kp LEFT      &kp UP        &kp SPACE                &kp DOWN  &kp RIGHT                                              &kp HOME       &kp PG_UP  &kp ENTER       &kp PG_DN  &kp END
                                                     &kp A                                                                           &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_DOWN K_SCROLL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&trans    &kp F1   &kp F2              &kp F3         &kp F4             &kp F5         &kp F6     &kp F7          &kp F8          &kp F9                &kp F10           &trans
&trans    &kp F11  &kp LC(LEFT_ARROW)  &kp PAGE_UP    &kp LC(RIGHT)      &kp HOME       &kp LG(C)  &mkp MB1        &kp UP_ARROW    &mkp MB2              &mkp MB3          &trans
&trans    &kp F12  &kp LA(LG(LEFT))    &kp PAGE_DOWN  &kp LA(LG(RIGHT))  &kp END        &kp LG(V)  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT             &kp RC(UP_ARROW)  &trans
&trans    &trans   &kp LALT                           &kp ENTER          &kp ENTER      &kp ENTER  &kp ENTER                       &kp RS(RG(NUMBER_4))  &kp RC(SPACE)     &trans
&kp LEFT  &kp UP   &kp SPACE           &kp DOWN       &kp RIGHT                                    &kp HOME        &kp PG_UP       &kp ENTER             &kp PG_DN         &kp END
                                       &kp A                                                                       &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&kp CAPS         &kp SLASH  &kp NUMBER_7  &kp N8        &kp N9        &kp LS(N8)         &kp NON_US_BACKSLASH  &kp EXCLAMATION        &kp AT_SIGN       &kp HASH           &kp DOLLAR         &trans
&trans           &kp COLON  &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp MINUS          &kp GRAVE             &kp PERCENT            &kp LCTRL         &kp AMPS           &kp SEMICOLON      &trans
&mt LSHFT SPACE  &kp UNDER  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp LS(EQUAL)      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SQT            &trans
&trans           &kp ENTER  &kp N0                      &kp EQUAL     &kp ENTER          &kp ENTER             &kp ENTER                                &kp RS(GRAVE)      &kp DOUBLE_QUOTES  &trans
&kp LEFT         &kp UP     &kp SPACE     &kp DOWN      &kp RIGHT                                              &kp HOME               &kp PG_UP         &kp ENTER          &kp PG_DN          &kp END
                                          &kp A                                                                                       &kp B
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB1  &trans     &mkp MB2   &mkp MB3   &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                              &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &bt BT_CLR_ALL  &studio_unlock  &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans          &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans            &trans          &trans          &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans            &trans          &trans                     &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                       &kp HOME        &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                                         &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        // Index 6: kept separate so AML timeout never disables manual Mouse (3).
        // Repeat base Ctrl/Esc so runtime AML preserves Ctrl-click on this mod-tap.

        auto_mouse_layer {
            label = "Auto Mouse";
            bindings = <
&trans        &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&trans        &trans  &trans     &trans    &trans     &trans      &trans  &mkp MB1  &trans     &mkp MB2   &trans     &trans
&trans        &trans  &trans     &trans    &trans     &trans      &trans  &trans    &trans     &trans     &trans     &trans
&mt LCTL ESC  &trans  &trans               &trans     &trans      &trans  &trans               &trans     &trans     &trans
&kp LEFT      &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                      &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                 &kp A                                              &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
